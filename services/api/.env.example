# ==============================================================================
# ORCA BACKEND ENVIRONMENT CONFIGURATION (FastAPI)
# File location: services/api/.env.example
# Copy to services/api/.env and fill in appropriate values
# ==============================================================================

# Runtime Environment (development, test, staging, production)
# In production, strict fail-fast validation ensures all security invariants are met.
ENVIRONMENT=development

PROJECT_NAME="ORCA Marine AI API"
VERSION="0.1.0"
API_V1_STR="/api"

# 1. Supabase Project Authentication & Keys
# Obtain from: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Supabase JWT Secret (from: Project Settings -> API -> JWT Settings -> JWT Secret)
# Used by FastAPI to cryptographically verify user tokens (HS256 HMAC-SHA256).
# In production: MUST be >= 32 characters and cannot use default demo values.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-minimum-32-chars-here

# 2. Database Connection URL
# Production: PostgreSQL with asyncpg (e.g. Supabase connection pooler):
# DATABASE_URL=postgresql+asyncpg://postgres.your-project:your-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres
# Development/Testing fallback (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./orca_local.db

# 3. CORS Settings & Canonical Frontend Origin
# In production: must match your live deployed web application URL.
FRONTEND_URL=http://localhost:3000
# Optional JSON array of allowed origins (defaults to [FRONTEND_URL, http://localhost:3000, ...])
# CORS_ORIGINS=["https://orca-marine.in"]

# 4. Open-Meteo Integration
OPEN_METEO_TIMEOUT_SECONDS=10.0

# 5. Resilient LLM Engine (Tier 1: OpenRouter Free Models | Tier 2: Local Ollama)
# Get a free OpenRouter key from: https://openrouter.ai/keys (Free models require 0 balance)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_OPENROUTER_MODEL=liquid/lfm-2.5-2.6b:free

# Local Offline Ollama Engine (Tier 2 Fallback)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
DEFAULT_OLLAMA_MODEL=llama3.2
LLM_TIMEOUT_SECONDS=90.0
