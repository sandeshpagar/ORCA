# ==============================================================================
# ORCA ROOT & FRONTEND ENVIRONMENT CONFIGURATION (Next.js)
# File location: .env.example
# Copy to .env.local for local Next.js frontend development
# ==============================================================================

# 1. FastAPI Backend Base URL
# URL pointing to the FastAPI backend service
# In local development: http://localhost:8000
# In production: https://api.orca-marine.in
NEXT_PUBLIC_API_URL=http://localhost:8000

# 2. Supabase Public Client Credentials
# Obtain from: https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
